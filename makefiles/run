# ==============================================================================
# MCUML Execution / Run Makefile (makefiles/run)
# Runs Pre-Silicon (QEMU simulation) and Post-Silicon (Pico flash & monitor).
#
# Usage:
#   make -f makefiles/run presil [KERNEL="..."] [TIMEOUT="..."] [SIM_ARGS="..."]
#   make -f makefiles/run postsil [UF2="..."]
#   make -f makefiles/run monitor [PORT="..."] [BAUD="..."]
# ==============================================================================

ROOT_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
BUILD_DIR ?= $(ROOT_DIR)/build

PYTHON   ?= python3
PICOTOOL ?= picotool

# Auto-detect default binaries
TARGET ?= firmware
DEFAULT_PRESIL_ELF := $(firstword $(wildcard $(BUILD_DIR)/presil/*.elf) $(ROOT_DIR)/tools/test_binary/firmware.elf)
DEFAULT_POSTSIL_UF2 := $(firstword $(wildcard $(BUILD_DIR)/postsil/*.uf2) $(ROOT_DIR)/model/firmware/drivers/usb/test_usb.uf2 $(BUILD_DIR)/postsil/$(TARGET).uf2)

KERNEL   ?= $(DEFAULT_PRESIL_ELF)
UF2      ?= $(DEFAULT_POSTSIL_UF2)
TIMEOUT  ?=
SIM_ARGS ?=

# Serial monitor parameters (auto-detect Linux ttyACM/ttyUSB/serial0 and macOS cu.usbmodem)
PORT ?= $(firstword $(wildcard /dev/ttyACM*) $(wildcard /dev/ttyUSB*) $(wildcard /dev/serial0) $(wildcard /dev/cu.usbmodem*) /dev/ttyACM0)
BAUD ?= 115200

.PHONY: all presil postsil run-presil run-postsil usb run-usb monitor help

all: presil

# ==============================================================================
# Pre-Silicon Run Target (QEMU Simulator)
# ==============================================================================
presil: run-presil
run-presil:
	@echo "============================================================"
	@echo " [RUN] Pre-Silicon QEMU Simulation (Cortex-M0+)"
	@echo "============================================================"
	@if [ ! -f "$(KERNEL)" ]; then \
		echo "ERROR: Kernel binary '$(KERNEL)' not found."; \
		echo "Please build first via: make -f makefiles/build presil"; \
		exit 1; \
	fi
	@echo "Kernel:   $(KERNEL)"
	@echo "Runner:   tools/sim/sim_connect.py"
	@echo ""
	@$(PYTHON) $(ROOT_DIR)/tools/sim/sim_connect.py \
		--kernel "$(KERNEL)" \
		$(if $(TIMEOUT),--timeout $(TIMEOUT),) \
		$(SIM_ARGS) || [ $$? -eq 124 ]

# ==============================================================================
# Post-Silicon Run Target (Flash & Reboot Raspberry Pi Pico)
# ==============================================================================
postsil: run-postsil
run-postsil:
	@echo "============================================================"
	@echo " [RUN] Post-Silicon Hardware Flash (Raspberry Pi Pico)"
	@echo "============================================================"
	@if [ ! -f "$(UF2)" ]; then \
		echo "ERROR: UF2 binary '$(UF2)' not found."; \
		echo "Please build first via: make -f makefiles/build postsil"; \
		exit 1; \
	fi
	@echo "Binary:   $(UF2)"
	@echo ""
	@if which $(PICOTOOL) >/dev/null 2>&1; then \
		echo "Flashing via picotool..."; \
		if ! $(PICOTOOL) load -x -f "$(UF2)" 2>/tmp/picotool_err.log; then \
			status=$$?; \
			if [ $$status -eq 157 ]; then \
				:; \
			else \
				cat /tmp/picotool_err.log 2>/dev/null; \
				echo ""; \
				echo "============================================================"; \
				echo " [!] Pico Not Detected in BOOTSEL Mode"; \
				echo "============================================================"; \
				echo "If the currently running firmware halted or disabled USB,"; \
				echo "picotool cannot reboot the device automatically."; \
				echo ""; \
				echo "To flash:"; \
				echo "  1. Unplug the USB cable from the Pico."; \
				echo "  2. Hold down the white BOOTSEL button on the Pico."; \
				echo "  3. Plug the USB cable back in."; \
				echo "  4. Release the BOOTSEL button."; \
				echo "  5. Re-run: make run-usb"; \
				echo "============================================================"; \
				rm -f /tmp/picotool_err.log; \
				exit 1; \
			fi; \
		fi; \
		rm -f /tmp/picotool_err.log; \
	elif [ -d "/Volumes/RPI-RP2" ]; then \
		echo "Copying to /Volumes/RPI-RP2..."; \
		cp "$(UF2)" /Volumes/RPI-RP2/; \
	elif [ -n "$$(ls -d /media/*/RPI-RP2 2>/dev/null)" ]; then \
		target_mount=$$(ls -d /media/*/RPI-RP2 2>/dev/null | head -n 1); \
		echo "Copying to $$target_mount..."; \
		cp "$(UF2)" "$$target_mount/"; \
	else \
		echo "ERROR: Pico not detected in BOOTSEL or serial mode."; \
		echo "Hold BOOTSEL while plugging in USB, or run: picotool reboot -f -u"; \
		exit 1; \
	fi
	@echo ""
	@echo "[SUCCESS] Post-Silicon binary loaded successfully."

# ==============================================================================
# Post-Silicon USB CDC Target (Flash test_usb.uf2 with live CDC & LED)
# ==============================================================================
usb: run-usb
run-usb:
	@$(MAKE) -f $(firstword $(MAKEFILE_LIST)) postsil UF2=$(ROOT_DIR)/model/firmware/drivers/usb/test_usb.uf2

# ==============================================================================
# Monitor Serial Console
# ==============================================================================
monitor:
	@echo "Connecting to serial port $(PORT) at $(BAUD) baud..."
	@if [ -z "$(PORT)" ] || [ ! -e "$(PORT)" ]; then \
		echo "ERROR: No serial device detected at $(PORT)."; \
		echo "Available ports: $$(ls /dev/ttyACM* /dev/ttyUSB* /dev/serial0 /dev/cu.usbmodem* 2>/dev/null || echo 'none')"; \
		echo "Tip: Run 'dmesg -w' or 'lsusb' to verify physical connection."; \
		exit 1; \
	fi
	@if which $(PYTHON) >/dev/null 2>&1 && $(PYTHON) -c "import serial.tools.miniterm" >/dev/null 2>&1; then \
		echo "Starting miniterm (Press Ctrl-] to exit)..."; \
		$(PYTHON) -m serial.tools.miniterm "$(PORT)" $(BAUD); \
	elif which screen >/dev/null 2>&1; then \
		echo "Starting screen (Press Ctrl-A then K, then Y to exit)..."; \
		screen "$(PORT)" $(BAUD); \
	elif which minicom >/dev/null 2>&1; then \
		echo "Starting minicom (Press Ctrl-A then X to exit)..."; \
		minicom -b $(BAUD) -o -D "$(PORT)"; \
	else \
		echo "Starting raw stream from $(PORT) (Press Ctrl-C to exit)..."; \
		stty -F "$(PORT)" $(BAUD) raw -echo 2>/dev/null || true; \
		cat "$(PORT)"; \
	fi

# ==============================================================================
# Help
# ==============================================================================
help:
	@echo "MCUML Run / Execution System"
	@echo "Targets:"
	@echo "  presil   - Launch QEMU simulation for Cortex-M33"
	@echo "  postsil  - Flash binary to Raspberry Pi Pico (RP2040)"
	@echo "  monitor  - Connect to USB serial port (screen)"
	@echo ""
	@echo "Variables:"
	@echo "  KERNEL   - Path to ELF binary for QEMU (default: build/presil/*.elf)"
	@echo "  UF2      - Path to UF2 binary for Pico (default: build/postsil/*.uf2)"
	@echo "  TIMEOUT  - Simulation timeout in seconds (optional)"
	@echo "  PORT     - Serial port (default: auto-detected /dev/cu.usbmodem*)"
	@echo "  BAUD     - Baud rate (default: 115200)"
	@echo ""
	@echo "Examples:"
	@echo "  make -f makefiles/run presil"
	@echo "  make -f makefiles/run presil KERNEL=build/presil/test_uart.elf TIMEOUT=5"
	@echo "  make -f makefiles/run postsil UF2=build/postsil/test_usb.uf2"
	@echo "  make -f makefiles/run monitor"
