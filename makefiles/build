# ==============================================================================
# MCUML Unified Build Makefile (makefiles/build)
# Consolidated single startup (startup.c) and single linker (linker.ld) design.
# Supports Pre-Silicon (QEMU / Cortex-M0+) and Post-Silicon (Pico / RP2040).
#
# Usage:
#   make -f makefiles/build presil [SRCS="..."] [INCS="..."] [TARGET="..."]
#   make -f makefiles/build postsil [SRCS="..."] [INCS="..."] [TARGET="..."]
#   make -f makefiles/build all
#   make -f makefiles/build clean
# ==============================================================================

ROOT_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
BUILD_DIR ?= $(ROOT_DIR)/build

# Toolchain configuration (cross-compilation for ARM Cortex-M0+)
ARM_TOOLCHAIN_DIR := $(firstword $(wildcard /Applications/ArmGNUToolchain/*/arm-none-eabi/bin))
ifneq ($(ARM_TOOLCHAIN_DIR),)
    CROSS_COMPILE ?= $(ARM_TOOLCHAIN_DIR)/arm-none-eabi-
    export PATH   := $(ARM_TOOLCHAIN_DIR):$(PATH)
else
    CROSS_COMPILE ?= arm-none-eabi-
endif

ifeq ($(origin CC),default)
    CC := $(CROSS_COMPILE)gcc
endif
ifeq ($(origin CXX),default)
    CXX := $(CROSS_COMPILE)g++
endif

CC      ?= $(CROSS_COMPILE)gcc
CXX     ?= $(CROSS_COMPILE)g++
OBJCOPY ?= $(CROSS_COMPILE)objcopy
OBJDUMP ?= $(CROSS_COMPILE)objdump
SIZE    ?= $(CROSS_COMPILE)size

PICOTOOL ?= picotool

# ==============================================================================
# Single Consolidated Startup & Single Linker Script
# ==============================================================================
STARTUP  := $(ROOT_DIR)/model/firmware/startup/startup.c
LDSCRIPT := $(ROOT_DIR)/model/firmware/linker/linker.ld

# Defaults
DEFAULT_PRESIL_SRCS := $(ROOT_DIR)/model/firmware/drivers/uart/test_uart.c \
                       $(ROOT_DIR)/model/firmware/drivers/uart/uart.c
DEFAULT_PRESIL_INCS := -I $(ROOT_DIR)/model/firmware/drivers/uart/hdr

DEFAULT_POSTSIL_SRCS := $(ROOT_DIR)/model/firmware/drivers/uart/test_uart.c \
                        $(ROOT_DIR)/model/firmware/drivers/uart/uart.c
DEFAULT_POSTSIL_INCS := -I $(ROOT_DIR)/model/firmware/drivers/uart/hdr

# Common Architecture: ARM Cortex-M0+ (RP2040 / ARMv6-M)
CPU_FLAGS := -mcpu=cortex-m0plus -mthumb
CFLAGS    := $(CPU_FLAGS) -ffreestanding -nostdlib -Wall -Wextra -O2

# Output directories
PRESIL_BUILD_DIR  := $(BUILD_DIR)/presil
POSTSIL_BUILD_DIR := $(BUILD_DIR)/postsil

# Target binary name
TARGET ?= $(if $(SRCS),$(basename $(notdir $(firstword $(SRCS)))),firmware)

.PHONY: all presil postsil clean help

all: presil postsil

# ==============================================================================
# Pre-Silicon Build Target
# Uses: startup.c (.vectors @ 0x10000000) and linker.ld
# ==============================================================================
presil:
	@echo "============================================================"
	@echo " [BUILD] Pre-Silicon (Cortex-M0+ / QEMU)"
	@echo "============================================================"
	@mkdir -p $(PRESIL_BUILD_DIR)
	$(eval CURRENT_SRCS := $(if $(SRCS),$(SRCS),$(DEFAULT_PRESIL_SRCS)))
	$(eval CURRENT_INCS := $(if $(INCS),$(INCS),$(DEFAULT_PRESIL_INCS)))
	@echo "Target:  $(TARGET)"
	@echo "Sources: $(CURRENT_SRCS)"
	@echo "Startup: $(STARTUP) [Unified Single Startup]"
	@echo "Linker:  $(LDSCRIPT) [Unified Single Linker]"
	@echo "Flags:   $(CFLAGS) -DPRESIL $(CURRENT_INCS)"
	@echo ""
	$(CC) $(CFLAGS) -DPRESIL $(CURRENT_INCS) \
		-T $(LDSCRIPT) \
		$(STARTUP) \
		$(CURRENT_SRCS) \
		-o $(PRESIL_BUILD_DIR)/$(TARGET).elf
	$(OBJCOPY) -O binary $(PRESIL_BUILD_DIR)/$(TARGET).elf $(PRESIL_BUILD_DIR)/$(TARGET).bin
	@echo ""
	@echo "Generated:"
	@echo "  ELF: $(PRESIL_BUILD_DIR)/$(TARGET).elf"
	@echo "  BIN: $(PRESIL_BUILD_DIR)/$(TARGET).bin"
	@if which $(SIZE) >/dev/null 2>&1; then $(SIZE) $(PRESIL_BUILD_DIR)/$(TARGET).elf; fi
	@echo "[SUCCESS] Pre-Silicon build complete."

# ==============================================================================
# Post-Silicon Build Target
# Uses: SAME startup.c (.boot2 @ 0x10000000, .vectors @ 0x10000100) and SAME linker.ld
# ==============================================================================
postsil:
	@echo "============================================================"
	@echo " [BUILD] Post-Silicon (Raspberry Pi Pico / RP2040)"
	@echo "============================================================"
	@mkdir -p $(POSTSIL_BUILD_DIR)
	$(eval CURRENT_SRCS := $(if $(SRCS),$(SRCS),$(DEFAULT_POSTSIL_SRCS)))
	$(eval CURRENT_INCS := $(if $(INCS),$(INCS),$(DEFAULT_POSTSIL_INCS)))
	@echo "Target:  $(TARGET)"
	@echo "Sources: $(CURRENT_SRCS)"
	@echo "Startup: $(STARTUP) [Unified Single Startup]"
	@echo "Linker:  $(LDSCRIPT) [Unified Single Linker]"
	@echo "Flags:   $(CFLAGS) -DPOSTSIL $(CURRENT_INCS)"
	@echo ""
	$(CC) $(CFLAGS) -DPOSTSIL $(CURRENT_INCS) \
		-T $(LDSCRIPT) \
		$(STARTUP) \
		$(CURRENT_SRCS) \
		-o $(POSTSIL_BUILD_DIR)/$(TARGET).elf
	$(OBJCOPY) -O binary $(POSTSIL_BUILD_DIR)/$(TARGET).elf $(POSTSIL_BUILD_DIR)/$(TARGET).bin
	@if which $(PICOTOOL) >/dev/null 2>&1; then \
		$(PICOTOOL) uf2 convert $(POSTSIL_BUILD_DIR)/$(TARGET).elf $(POSTSIL_BUILD_DIR)/$(TARGET).uf2 --family rp2040 >/dev/null 2>&1; \
		echo "  UF2: $(POSTSIL_BUILD_DIR)/$(TARGET).uf2"; \
	fi
	@echo ""
	@echo "Generated:"
	@echo "  ELF: $(POSTSIL_BUILD_DIR)/$(TARGET).elf"
	@echo "  BIN: $(POSTSIL_BUILD_DIR)/$(TARGET).bin"
	@if which $(SIZE) >/dev/null 2>&1; then $(SIZE) $(POSTSIL_BUILD_DIR)/$(TARGET).elf; fi
	@echo "[SUCCESS] Post-Silicon build complete."

# ==============================================================================
# Clean
# ==============================================================================
clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(BUILD_DIR)
	@echo "Done."

# ==============================================================================
# Help
# ==============================================================================
help:
	@echo "MCUML Consolidated Build System"
	@echo "Unified Single Startup: model/firmware/startup/startup.c"
	@echo "Unified Single Linker:  model/firmware/linker/linker.ld"
	@echo ""
	@echo "Targets:"
	@echo "  presil   - Compile for Cortex-M0+ / QEMU simulation"
	@echo "  postsil  - Compile for Raspberry Pi Pico (RP2040 / Cortex-M0+)"
	@echo "  clean    - Remove build outputs"
	@echo ""
	@echo "Variables:"
	@echo "  SRCS     - List of C source files (space-separated)"
	@echo "  INCS     - Include flags (e.g. -I dir1 -I dir2)"
	@echo "  TARGET   - Output binary name"
