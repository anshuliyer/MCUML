#!/usr/bin/env bash
# ==============================================================================
# MCUML Minimal Build Script (./build)
#
# Flags:
#   -c <code.c...>      Source C or assembly files
#   -i <headers...>     Header / include directories
#   -s <startup>        Startup file (default: model/firmware/startup/startup.c)
#   -l <linker>         Linker script (default: model/firmware/linker/linker.ld)
#   -o <outdir>         Output directory (default: out)
#   -m <pico|qemu>      Target platform: pico (default) or qemu
#   -h                  Help
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${PYTHON:-python3}"
PICOTOOL="${PICOTOOL:-picotool}"

# Toolchain detection
if which arm-none-eabi-gcc >/dev/null 2>&1; then
    CC="arm-none-eabi-gcc"
    OBJCOPY="arm-none-eabi-objcopy"
    SIZE="arm-none-eabi-size"
else
    toolchain_bin=$(ls -d /Applications/ArmGNUToolchain/*/arm-none-eabi/bin 2>/dev/null | head -n 1 || true)
    if [[ -n "$toolchain_bin" && -x "$toolchain_bin/arm-none-eabi-gcc" ]]; then
        CC="$toolchain_bin/arm-none-eabi-gcc"
        OBJCOPY="$toolchain_bin/arm-none-eabi-objcopy"
        SIZE="$toolchain_bin/arm-none-eabi-size"
    else
        echo "ERROR: arm-none-eabi-gcc not found in PATH."
        exit 1
    fi
fi

show_help() {
    cat << 'EOF'
MCUML Simple Build

Usage:
  ./build [-c <code.c...>] [-i <headers...>] [-s <startup>] [-l <linker>] [-o <outdir>] [-m <pico|qemu>]
  ./build clean
  ./build -h

Flags:
  -c   Code / C source files (default: model/firmware/drivers/uart/test_uart.c model/firmware/drivers/uart/uart.c)
  -i   Header / include directories (default: model/firmware/drivers/uart/hdr)
  -s   Startup file (default: model/firmware/startup/startup.c)
  -l   Linker script (default: model/firmware/linker/linker.ld)
  -o   Output directory (default: out)
  -m   Target mode: 'pico' (default) or 'qemu'
  -h   Display this help message

Examples:
  ./build
  ./build -c model/firmware/test/test_gpio.c
  ./build -c app.c -i include/ -l custom.ld -o build_out
  ./build -m qemu -c test.c
  ./build clean
EOF
}

# Python UF2 converter fallback (if picotool is absent)
convert_to_uf2_python() {
    local bin_in="$1"
    local uf2_out="$2"
    "$PYTHON" -c '
import struct, sys
bin_path, uf2_path = sys.argv[1], sys.argv[2]
with open(bin_path, "rb") as f: data = f.read()
num_blocks = (len(data) + 255) // 256
with open(uf2_path, "wb") as f:
    for i in range(num_blocks):
        chunk = data[i*256 : (i+1)*256]
        payload = chunk.ljust(256, b"\x00")
        hdr = struct.pack("<IIIIIIII", 0x0A324655, 0x9E5D5157, 0x2000, 0x10000000 + i*256, 256, i, num_blocks, 0xe48ff56a)
        f.write(hdr + payload + b"\x00"*220 + struct.pack("<I", 0x0AB16F30))
' "$bin_in" "$uf2_out"
}

# Defaults
sources=()
includes=()
startup="${SCRIPT_DIR}/model/firmware/startup/startup.c"
linker="${SCRIPT_DIR}/model/firmware/linker/linker.ld"
out_dir="${SCRIPT_DIR}/out"
mode="pico"
target="firmware"

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        clean)
            echo "Cleaning $out_dir..."
            rm -rf "$out_dir"
            echo "Done."
            exit 0
            ;;
        bootloader|bl1)
            echo "Building bootloader (Pico SDK + TinyUSB)..."
            mkdir -p "${SCRIPT_DIR}/model/firmware/bootloader/build"
            cmake -B "${SCRIPT_DIR}/model/firmware/bootloader/build" -S "${SCRIPT_DIR}/model/firmware/bootloader"
            cmake --build "${SCRIPT_DIR}/model/firmware/bootloader/build"
            mkdir -p "$out_dir"
            cp -f "${SCRIPT_DIR}/model/firmware/bootloader/build/bl1.uf2" "$out_dir/bl1.uf2"
            echo ""
            echo "Generated: $out_dir/bl1.uf2 (Pico Flashable)"
            exit 0
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        -c|--code|-s_c)
            shift
            while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                sources+=("$1")
                shift
            done
            ;;
        -i|-I|--inc|--headers)
            includes+=("-I" "$2")
            shift 2
            ;;
        -s|--startup)
            startup="$2"
            shift 2
            ;;
        -l|--linker|-T)
            linker="$2"
            shift 2
            ;;
        -o|--output|--outdir)
            out_dir="$2"
            shift 2
            ;;
        -m|--mode)
            mode="$2"
            shift 2
            ;;
        *.c|*.s|*.S)
            sources+=("$1")
            shift
            ;;
        *)
            echo "Unknown flag: $1"
            show_help
            exit 1
            ;;
    esac
done

# Apply defaults if empty
if [[ ${#sources[@]} -eq 0 ]]; then
    sources=(
        "${SCRIPT_DIR}/model/firmware/drivers/uart/test_uart.c"
        "${SCRIPT_DIR}/model/firmware/drivers/uart/uart.c"
    )
fi

if [[ ${#includes[@]} -eq 0 ]]; then
    includes=("-I" "${SCRIPT_DIR}/model/firmware/drivers/uart/hdr")
fi

target=$(basename "${sources[0]}" .c)
mkdir -p "$out_dir"

# Compiler flags
cflags=(
    -mcpu=cortex-m0plus
    -mthumb
    -ffreestanding
    -nostdlib
    -Wall
    -Wextra
    -O2
)

if [[ "$mode" == "qemu" ]]; then
    cflags+=("-DPRESIL")
    banner="QEMU Simulation"
else
    cflags+=("-DPOSTSIL")
    banner="Raspberry Pi Pico (RP2040)"
fi

elf_out="${out_dir}/${target}.elf"
bin_out="${out_dir}/${target}.bin"
uf2_out="${out_dir}/${target}.uf2"

echo "============================================================"
echo " [BUILD] ${banner}"
echo "============================================================"
echo "Code:    ${sources[*]}"
echo "Headers: ${includes[*]}"
echo "Startup: $startup"
echo "Linker:  $linker"
echo "Output:  $out_dir"
echo ""

# 1. Compile ELF
"$CC" "${cflags[@]}" "${includes[@]}" -T "$linker" "$startup" "${sources[@]}" -o "$elf_out"

# 2. Extract BIN
"$OBJCOPY" -O binary "$elf_out" "$bin_out"

# 3. If Pico, convert to UF2
if [[ "$mode" != "qemu" ]]; then
    if which "$PICOTOOL" >/dev/null 2>&1; then
        "$PICOTOOL" uf2 convert "$elf_out" "$uf2_out" --family rp2040 >/dev/null 2>&1 || true
    fi
    if [[ ! -f "$uf2_out" ]]; then
        convert_to_uf2_python "$bin_out" "$uf2_out"
    fi
fi

echo "Generated:"
echo "  ELF: $elf_out"
echo "  BIN: $bin_out"
if [[ -f "$uf2_out" ]]; then
    echo "  UF2: $uf2_out (Pico Flashable)"
fi

if which "$SIZE" >/dev/null 2>&1; then
    echo ""
    "$SIZE" "$elf_out"
fi

echo ""
echo "[SUCCESS] Build complete."
