#!/usr/bin/env bash
# ==============================================================================
# MCUML Minimal Runner (./run)
#
# Usage:
#   ./run qemu [binary.elf]    Run in QEMU simulation (arch: Cortex-M)
#   ./run pico [binary.uf2]    Auto-bootsel, converts to UF2 if ELF, and flashes Pico
#   ./run monitor [port]       Open USB serial console
#   ./run -h                   Help
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${PYTHON:-python3}"
PICOTOOL="${PICOTOOL:-picotool}"

show_help() {
    cat << 'EOF'
MCUML Simple Runner

Usage:
  ./run qemu [path/to/binary.elf]   Run in QEMU simulator (architecture pre-configured)
  ./run pico [path/to/binary]       Reboot to BOOTSEL, convert to UF2, and flash Pico
  ./run monitor [port]              Open serial monitor (auto-detects /dev/ttyACM*)
  ./run -h                          Display this help

Examples:
  ./run qemu out/test_uart.elf
  ./run pico out/test_gpio.uf2
  ./run pico out/test_gpio.elf     (auto-converts ELF to UF2 before flashing)
  ./run pico                       (prompts for binary if omitted)
  ./run monitor
EOF
}

# ------------------------------------------------------------------------------
# QEMU Runner
# ------------------------------------------------------------------------------
run_qemu() {
    local binary="${1:-}"

    # Accept -b flag if passed
    if [[ "$binary" == "-b" ]]; then
        binary="${2:-}"
    fi

    # If no binary passed, ask or auto-pick newest in out/
    if [[ -z "$binary" ]]; then
        local newest
        newest=$(ls -t "${SCRIPT_DIR}/out"/*.elf 2>/dev/null | head -n 1 || true)
        if [[ -n "$newest" ]]; then
            binary="$newest"
        else
            read -r -p "Enter path to ELF binary: " binary
        fi
    fi

    if [[ ! -f "$binary" ]]; then
        echo "ERROR: Binary '$binary' not found."
        exit 1
    fi

    echo "============================================================"
    echo " [RUN] QEMU Simulation (Cortex-M0+)"
    echo "============================================================"
    echo "Binary: $binary"
    echo ""

    "$PYTHON" "${SCRIPT_DIR}/tools/sim/sim_connect.py" --kernel "$binary" || [[ $? -eq 124 ]]
}

# ------------------------------------------------------------------------------
# Pico Hardware Flasher (Reboots to BOOTSEL, converts to UF2, flashes)
# ------------------------------------------------------------------------------
run_pico() {
    local binary="${1:-}"

    if [[ "$binary" == "-b" ]]; then
        binary="${2:-}"
    fi

    # If no binary passed, prompt or pick newest in out/
    if [[ -z "$binary" ]]; then
        local newest
        newest=$(ls -t "${SCRIPT_DIR}/out"/*.uf2 "${SCRIPT_DIR}/out"/*.elf 2>/dev/null | head -n 1 || true)
        if [[ -n "$newest" ]]; then
            read -r -p "Enter binary path [default: $newest]: " input_bin
            binary="${input_bin:-$newest}"
        else
            read -r -p "Enter path to binary (UF2 or ELF): " binary
        fi
    fi

    if [[ ! -f "$binary" ]]; then
        echo "ERROR: Binary '$binary' not found."
        exit 1
    fi

    echo "============================================================"
    echo " [RUN] Raspberry Pi Pico Flasher"
    echo "============================================================"
    echo "Binary: $binary"
    echo ""

    # 1. Convert to UF2 if an ELF was provided
    if [[ "$binary" == *.elf ]]; then
        local uf2_out="${binary%.elf}.uf2"
        echo "Converting ELF to Pico UF2 ($uf2_out)..."
        if which "$PICOTOOL" >/dev/null 2>&1; then
            "$PICOTOOL" uf2 convert "$binary" "$uf2_out" --family rp2040 >/dev/null 2>&1 || true
        fi
        if [[ ! -f "$uf2_out" ]]; then
            # Python converter fallback
            "$PYTHON" -c '
import struct, sys
bin_path, uf2_path = sys.argv[1], sys.argv[2]
with open(bin_path, "rb") as f: data = f.read()
num_blocks = (len(data) + 255) // 256
with open(uf2_path, "wb") as f:
    for i in range(num_blocks):
        chunk = data[i*256 : (i+1)*256].ljust(256, b"\x00")
        hdr = struct.pack("<IIIIIIII", 0x0A324655, 0x9E5D5157, 0x2000, 0x10000000 + i*256, 256, i, num_blocks, 0xe48ff56a)
        f.write(hdr + chunk + b"\x00"*220 + struct.pack("<I", 0x0AB16F30))
' "${binary%.elf}.bin" "$uf2_out"
        fi
        binary="$uf2_out"
    fi

    # 2. Put board in BOOTSEL mode
    echo "Putting board in BOOTSEL mode..."
    "$PICOTOOL" reboot -f -u 2>/dev/null || true
    for port in /dev/ttyACM* /dev/cu.usbmodem*; do
        if [[ -e "$port" ]]; then
            stty -f "$port" 1200 2>/dev/null || stty -F "$port" 1200 2>/dev/null || true
        fi
    done
    sleep 0.5

    # 3. Flash binary
    echo "Flashing $binary..."
    if which "$PICOTOOL" >/dev/null 2>&1; then
        local err_log
        err_log=$(mktemp 2>/dev/null || echo "/tmp/picotool_err.log")
        if ! "$PICOTOOL" load -x -f "$binary" 2>"$err_log"; then
            local status=$?
            if [[ $status -ne 157 ]]; then
                cat "$err_log" 2>/dev/null || true
                echo ""
                echo "============================================================"
                echo " [!] Pico Not Detected in BOOTSEL Mode"
                echo "============================================================"
                echo "To flash manually:"
                echo "  1. Unplug the USB cable from the Pico."
                echo "  2. Hold down the white BOOTSEL button on the Pico."
                echo "  3. Plug the USB cable back in."
                echo "  4. Release the BOOTSEL button."
                echo "  5. Re-run: ./run pico $binary"
                echo "============================================================"
                rm -f "$err_log"
                exit 1
            fi
        fi
        rm -f "$err_log"
    elif [[ -d "/Volumes/RPI-RP2" ]]; then
        cp "$binary" /Volumes/RPI-RP2/
    elif [[ -n "$(ls -d /media/*/RPI-RP2 2>/dev/null || true)" ]]; then
        local mnt
        mnt=$(ls -d /media/*/RPI-RP2 2>/dev/null | head -n 1)
        cp "$binary" "$mnt/"
    else
        echo "ERROR: Pico not detected. Hold BOOTSEL button while plugging in USB."
        exit 1
    fi

    echo ""
    echo "[SUCCESS] Flashed and rebooted successfully."
}

# ------------------------------------------------------------------------------
# Serial Console Monitor
# ------------------------------------------------------------------------------
run_monitor() {
    local port="${1:-}"

    if [[ -z "$port" ]]; then
        for candidate in /dev/ttyACM* /dev/ttyUSB* /dev/serial0 /dev/cu.usbmodem*; do
            if [[ -e "$candidate" ]]; then
                port="$candidate"
                break
            fi
        done
        port="${port:-/dev/ttyACM0}"
    fi

    echo "Connecting to $port (115200 baud)..."
    if [[ ! -e "$port" ]]; then
        echo "ERROR: No serial port at $port."
        echo "Available: $(ls /dev/ttyACM* /dev/ttyUSB* /dev/cu.usbmodem* 2>/dev/null || echo 'none')"
        exit 1
    fi

    if which "$PYTHON" >/dev/null 2>&1 && "$PYTHON" -c "import serial.tools.miniterm" >/dev/null 2>&1; then
        "$PYTHON" -m serial.tools.miniterm "$port" 115200
    elif which screen >/dev/null 2>&1; then
        screen "$port" 115200
    else
        cat "$port"
    fi
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
    show_help
    exit 0
fi

subcmd="$1"
shift

case "$subcmd" in
    qemu|presil)
        run_qemu "$@"
        ;;
    pico|postsil)
        run_pico "$@"
        ;;
    monitor)
        run_monitor "$@"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo "Unknown command: '$subcmd'"
        show_help
        exit 1
        ;;
esac
